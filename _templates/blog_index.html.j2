{% extends "blog_base.html.j2" %}
{% block main %}
<section class="blog-hero" aria-label="Blog">
    <div class="blog-hero-inner">
        <h1 class="blog-hero-title">Blog</h1>
        <p class="blog-hero-lead">Control del correo corporativo: guías claras sobre SPF, DKIM, DMARC y quién envía con el dominio de tu empresa.</p>
    </div>
</section>

<section class="blog-home">
    {% if featured %}
    <article class="blog-featured">
        <a class="blog-featured-link" href="/blog/{{ featured.slug }}/">
            <div class="blog-featured-media">
                <img
                    src="{{ featured.cover or featured.cover_path }}"
                    alt="Portada: {{ featured.title }}"
                    width="1200"
                    height="630"
                    loading="eager"
                    decoding="async"
                    class="blog-featured-img"
                >
            </div>
            <div class="blog-featured-body">
                <span class="blog-chip">{{ featured.category_label }}</span>
                <h2 class="blog-featured-title">{{ featured.title }}</h2>
                <p class="blog-featured-excerpt">{{ featured.excerpt }}</p>
                <p class="blog-card-meta">
                    <time datetime="{{ featured.date }}">{{ featured.date_display }}</time>
                    <span aria-hidden="true">·</span>
                    <span>{{ featured.reading_label }}</span>
                </p>
            </div>
        </a>
    </article>
    {% endif %}

    {% if grid_posts %}
    <ul class="blog-grid">
        {% for post in grid_posts %}
        <li class="blog-card">
            <a class="blog-card-link" href="/blog/{{ post.slug }}/">
                <div class="blog-card-media">
                    <img
                        src="{{ post.cover or post.cover_path }}"
                        alt="Portada: {{ post.title }}"
                        width="1200"
                        height="630"
                        loading="lazy"
                        decoding="async"
                        class="blog-card-img"
                    >
                </div>
                <div class="blog-card-body">
                    <span class="blog-chip">{{ post.category_label }}</span>
                    <h2 class="blog-card-title">{{ post.title }}</h2>
                    <p class="blog-card-excerpt">{{ post.excerpt }}</p>
                    <p class="blog-card-meta">
                        <time datetime="{{ post.date }}">{{ post.date_display }}</time>
                        <span aria-hidden="true">·</span>
                        <span>{{ post.reading_label }}</span>
                    </p>
                </div>
            </a>
        </li>
        {% endfor %}
    </ul>
    {% elif not featured %}
    <p class="blog-empty">Pronto publicaremos los primeros artículos. Mientras tanto puedes usar el <a href="/domain-checker">diagnóstico gratuito</a> o las <a href="/herramientas">herramientas</a>.</p>
    {% endif %}
</section>
{% endblock %}
