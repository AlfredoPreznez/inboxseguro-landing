{% extends "blog_base.html.j2" %}
{% block head_extra %}
<script type="application/ld+json">
{{ blog_posting_json|safe }}
</script>
<script type="application/ld+json">
{{ breadcrumb_json|safe }}
</script>
{% if faq_json %}
<script type="application/ld+json">
{{ faq_json|safe }}
</script>
{% endif %}
{% endblock %}
{% block main %}
<article class="blog-article">
    <header class="blog-article-hero">
        <div class="blog-article-hero-inner">
            <nav class="blog-breadcrumbs blog-breadcrumbs--on-dark" aria-label="Miga de pan">
                <a href="/">Inicio</a><span>/</span><a href="/blog/">Blog</a><span>/</span>{{ post.title }}
            </nav>
            <span class="blog-chip blog-chip--on-dark">{{ post.category_label }}</span>
            <h1 class="blog-article-h1">{{ post.title }}</h1>
            <p class="blog-meta blog-meta--on-dark">
                <time datetime="{{ post.date }}"{% if post.updated %} data-updated="{{ post.updated }}"{% endif %}>
                    {{ post.date_display }}
                </time>
                <span aria-hidden="true">·</span>
                <span>{{ post.reading_label }}</span>
                {% if post.updated and post.updated != post.date %}
                <span aria-hidden="true">·</span>
                <span>Actualizado <time datetime="{{ post.updated }}">{{ post.updated_display }}</time></span>
                {% endif %}
            </p>
            {% if audio %}
            <div class="blog-listen" data-nosnippet>
                <p class="blog-listen-label" id="blog-listen-label-{{ post.slug }}">
                    Escuchar este artículo{% if audio.duration_label %} · {{ audio.duration_label }}{% endif %}
                </p>
                <audio
                    class="blog-listen-audio"
                    controls
                    preload="none"
                    controlslist="nodownload"
                    aria-labelledby="blog-listen-label-{{ post.slug }}"
                >
                    <source src="{{ audio.url }}" type="audio/mpeg">
                    Tu navegador no admite audio HTML5.
                </audio>
            </div>
            {% endif %}
        </div>
    </header>

    <div class="blog-article-body{% if toc %} blog-article-body--with-toc{% endif %}">
        {% if toc %}
        <details class="blog-toc blog-toc--mobile">
            <summary class="blog-toc-summary">Contenido</summary>
            <ol class="blog-toc-list">
                {% for item in toc %}
                <li class="blog-toc-item{% if item.level == 3 %} blog-toc-item--sub{% endif %}">
                    <a href="#{{ item.id }}">{{ item.text }}</a>
                </li>
                {% endfor %}
            </ol>
        </details>
        {% endif %}

        <div class="blog-article-main">
            <div class="blog-prose">
                {% if post.resumen %}
                <div class="blog-summary" role="note" aria-label="Respuesta corta">
                    <p><strong>Respuesta corta:</strong> {{ post.resumen }}</p>
                </div>
                {% endif %}
                {{ body_html|safe }}
                {% if post.faq %}
                <section class="blog-faq" aria-labelledby="preguntas-frecuentes">
                    <h2 id="preguntas-frecuentes">Preguntas frecuentes</h2>
                    {% for item in post.faq %}
                    <h3>{{ item.q }}</h3>
                    <p>{{ item.a }}</p>
                    {% endfor %}
                </section>
                {% endif %}
            </div>

            <aside class="blog-cta" aria-label="Siguiente paso">
                <h2>Revisa tu dominio gratis</h2>
                <p>Usa las herramientas gratuitas para ver qué hay publicado en DNS, o agenda una demo si quieres inventario continuo de quién envía con tu dominio.</p>
                <div class="blog-cta-tools">
                    <a href="/spf-checker" data-seo-event="cta_spf_checker">Verificador SPF</a>
                    <a href="/dmarc-checker" data-seo-event="cta_dmarc_checker">Verificador DMARC</a>
                    <a href="/dkim-checker" data-seo-event="cta_dkim_checker">Verificador DKIM</a>
                </div>
                <div class="blog-cta-actions">
                    <a class="blog-cta-primary" href="/domain-checker" data-seo-event="cta_domain_checker">Diagnóstico completo</a>
                    <a class="blog-cta-secondary" href="https://calendly.com/alfredo-inboxseguro/30min" target="_blank" rel="noopener"
                       data-seo-event="cta_demo_calendly" onclick="if (typeof gtag==='function') gtag('event','schedule_demo');">Agendar demo</a>
                </div>
            </aside>
        </div>

        {% if toc %}
        <nav class="blog-toc blog-toc--desktop" aria-label="Contenido del artículo">
            <p class="blog-toc-title">Contenido</p>
            <ol class="blog-toc-list">
                {% for item in toc %}
                <li class="blog-toc-item{% if item.level == 3 %} blog-toc-item--sub{% endif %}">
                    <a href="#{{ item.id }}">{{ item.text }}</a>
                </li>
                {% endfor %}
            </ol>
        </nav>
        {% endif %}
    </div>
</article>
{% endblock %}
